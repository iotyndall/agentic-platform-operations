{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iotyndall/agentic-platform-operations/schemas/operation-record.schema.json",
  "title": "Agentic Platform Operations Operation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "operation_id",
    "repository",
    "incident_issue",
    "state",
    "sequence",
    "production_before_sha",
    "reproduction_sha",
    "candidate_sha",
    "reviewed_sha",
    "deployed_sha",
    "prior_known_good_sha",
    "resolution_path",
    "events"
  ],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "incident_issue": {"type": "integer", "minimum": 1},
    "state": {"$ref": "#/$defs/state"},
    "sequence": {"type": "integer", "minimum": 0},
    "production_before_sha": {"$ref": "#/$defs/nullableSha"},
    "reproduction_sha": {"$ref": "#/$defs/nullableSha"},
    "candidate_sha": {"$ref": "#/$defs/nullableSha"},
    "reviewed_sha": {"$ref": "#/$defs/nullableSha"},
    "deployed_sha": {"$ref": "#/$defs/nullableSha"},
    "prior_known_good_sha": {"$ref": "#/$defs/nullableSha"},
    "resolution_path": {
      "oneOf": [
        {"enum": ["healthy", "rolled_back"]},
        {"type": "null"}
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "from", "to", "actor", "evidence", "previous_event_sha256", "event_sha256"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "from": {"oneOf": [{"$ref": "#/$defs/state"}, {"type": "null"}]},
          "to": {"$ref": "#/$defs/state"},
          "actor": {"type": "string", "minLength": 1},
          "evidence": {"type": "object"},
          "previous_event_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "event_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nullableSha": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {
      "enum": [
        "observed",
        "oriented",
        "decided",
        "reproducing",
        "evidence_frozen",
        "repairing",
        "verifying",
        "reviewed",
        "release_authorized",
        "deployed",
        "production_probation",
        "healthy",
        "rollback_authorized",
        "rolled_back",
        "recovery_verified",
        "learning",
        "closed",
        "escalated"
      ]
    }
  }
}
