{
  "version": 1,
  "project": {
    "name": "Example SaaS Platform",
    "repository": "example-org/example-saas-platform",
    "defaultBranch": "main",
    "autonomyLevel": 2
  },
  "runtime": {
    "kind": "mixed",
    "nodeVersion": "22",
    "pythonVersion": "3.11",
    "packageManager": "pnpm"
  },
  "commands": {
    "install": "pnpm install --frozen-lockfile",
    "typecheck": "pnpm type-check",
    "test": "pnpm test",
    "lint": "pnpm lint",
    "build": "pnpm build",
    "migrationCheck": "echo 'Use the existing Supabase migration replay + tenant-isolation CI job'",
    "integration": "",
    "browser": "",
    "contract": "",
    "performance": "",
    "stagingVerify": "",
    "productionVerify": "python .github/scripts/daily_health_agent.py --self-test"
  },
  "risk": {
    "protectedPathRegex": "^(\\.github/|\\.agentic/|\\.env|supabase/migrations/|drizzle\\.config\\.|middleware\\.)|(^|/)(auth|stripe|payment|security|secret|credential)(/|\\.)",
    "maxAutonomousProductionLines": 60,
    "maxRepairAttempts": 2,
    "unknownRiskDefaultsTo": "high",
    "escalationDomains": [
      "authentication",
      "authorization",
      "row-level-security",
      "secrets",
      "destructive-data",
      "irreversible-migrations",
      "payments",
      "workflow-policy"
    ]
  },
  "security": {
    "dependencyAuditCommand": "pnpm audit --prod --json",
    "criticalAdvisoryAllowlist": [],
    "requirePinnedActions": true
  },
  "infrastructure": {
    "deploymentProvider": "Vercel",
    "database": "Supabase Postgres",
    "observability": [
      "Sentry",
      "Vercel",
      "Supabase",
      "GitHub Actions"
    ],
    "externalSystems": [
      "Social Graph API",
      "Background Job Runner",
      "Stripe",
      "LLM Provider"
    ]
  },
  "environments": {
    "development": {
      "name": "development",
      "protected": false,
      "credentials": "none"
    },
    "staging": {
      "name": "staging",
      "protected": false,
      "credentials": "environment"
    },
    "production": {
      "name": "production",
      "protected": true,
      "credentials": "environment"
    }
  },
  "evidence": {
    "sources": [
      {
        "id": "sentry",
        "kind": "logs",
        "redactionRequired": true,
        "customerContentAllowed": false
      },
      {
        "id": "vercel",
        "kind": "deployments",
        "redactionRequired": true,
        "customerContentAllowed": false
      },
      {
        "id": "supabase-status",
        "kind": "database-status",
        "redactionRequired": true,
        "customerContentAllowed": false
      },
      {
        "id": "github-actions",
        "kind": "other",
        "redactionRequired": true,
        "customerContentAllowed": false
      }
    ],
    "artifactRetentionDays": 30
  },
  "production": {
    "criticalJourneys": [
      {
        "id": "production-health-signals",
        "description": "Runtime/build/database/application signals remain observable and missing telemetry is never interpreted as clean health.",
        "owner": "local",
        "command": "python .github/scripts/daily_health_agent.py --self-test",
        "severityOnFailure": "P1"
      },
      {
        "id": "tenant-isolation",
        "description": "Migrations replay from scratch and tenant/RLS isolation assertions pass.",
        "owner": "local",
        "command": "",
        "severityOnFailure": "P0"
      },
      {
        "id": "scheduled-publishing",
        "description": "Scheduled social posts do not remain overdue and enabled agents continue producing/publishing expected output.",
        "owner": "local",
        "command": "",
        "severityOnFailure": "P1"
      }
    ]
  },
  "slo": {
    "defaultsRef": "iotyndall/agentic-platform-operations/slo/defaults.yaml",
    "errorBudgetGating": false,
    "objectives": []
  },
  "mitigations": [],
  "release": {
    "stagingEnvironment": "staging",
    "productionEnvironment": "production",
    "deploymentConcurrencyGroup": "deploy-production-saas",
    "rollbackRunbook": "runbooks/failed-deployment.md",
    "requireIndependentReview": true
  },
  "repair": {
    "enabled": true,
    "minimumConfidence": "high",
    "issueLabel": "auto-triage",
    "provenanceRegex": "<!--[[:space:]]*health-agent:[[:space:]]*fp=[a-z0-9][a-z0-9-]*[[:space:]]+seen=[0-9]+[[:space:]]+last=[^[:space:]]+[[:space:]]*-->",
    "reproductionRequired": true,
    "allowedEvidenceKinds": [
      "unit",
      "integration",
      "browser",
      "contract",
      "configuration",
      "synthetic"
    ]
  }
}
